   "source": [
    "\n",
    "# KPI dashboard\n",
    "kpis = {\n",
    "    \"Total Sales\": df[\"Sales\"].sum(),\n",
    "    \"Total Profit\": df[\"Profit\"].sum(),\n",
    "    \"Orders\": df[\"Order_ID\"].nunique(),\n",
    "    \"Customers\": df[\"Customer_ID\"].nunique(),\n",
    "    \"Avg. Discount\": df[\"Discount\"].mean(),\n",
    "}\n",
    "\n",
    "fig = plt.figure(figsize=(16, 11))\n",
    "gs = fig.add_gridspec(3, 2, height_ratios=[0.8, 1.2, 1.2])\n",
    "\n",
    "# KPI row\n",
    "ax_kpi = fig.add_subplot(gs[0, :])\n",
    "ax_kpi.axis(\"off\")\n",
    "kpi_text = \"     \".join([\n",
    "    f\"Sales: {kpis['Total Sales']:,.0f}\",\n",
    "    f\"Profit: {kpis['Total Profit']:,.0f}\",\n",
    "    f\"Orders: {kpis['Orders']:,}\",\n",
    "    f\"Customers: {kpis['Customers']:,}\",\n",
    "    f\"Avg Discount: {kpis['Avg. Discount']:.1%}\",\n",
    "])\n",
    "ax_kpi.text(0.5, 0.5, kpi_text, ha=\"center\", va=\"center\", fontsize=15, fontweight=\"bold\")\n",
    "\n",
    "# Category\n",
    "ax1 = fig.add_subplot(gs[1, 0])\n",
    "sns.barplot(data=category_perf.reset_index(), x=\"Category\", y=\"Profit\", hue=\"Category\", legend=False, ax=ax1)\n",
    "ax1.set_title(\"Profit by Category\")\n",
    "ax1.tick_params(axis=\"x\", rotation=20)\n",
    "\n",
    "# Region\n",
    "ax2 = fig.add_subplot(gs[1, 1])\n",
    "sns.barplot(data=region_perf.reset_index(), x=\"Region\", y=\"Sales\", hue=\"Region\", legend=False, ax=ax2)\n",
    "ax2.set_title(\"Sales by Region\")\n",
    "\n",
    "# Monthly trend\n",
    "ax3 = fig.add_subplot(gs[2, 0])\n",
    "ax3.plot(monthly[\"Order_Month\"], monthly[\"Sales\"], marker=\"o\", label=\"Sales\")\n",
    "ax3.plot(monthly[\"Order_Month\"], monthly[\"Profit\"], marker=\"o\", label=\"Profit\")\n",
    "ax3.set_title(\"Monthly Trend\")\n",
    "ax3.tick_params(axis=\"x\", rotation=45)\n",
    "ax3.legend()\n",
    "\n",
    "# Discount-profit\n",
    "ax4 = fig.add_subplot(gs[2, 1])\n",
    "sns.scatterplot(data=df, x=\"Discount\", y=\"Profit\", alpha=0.35, ax=ax4)\n",
    "sns.regplot(data=df, x=\"Discount\", y=\"Profit\", scatter=False, ci=None, ax=ax4)\n",
    "ax4.set_title(\"Discount vs Profit\")\n",
    "\n",
    "fig.suptitle(\"Retail Business Executive Dashboard\", fontsize=20, fontweight=\"bold\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
