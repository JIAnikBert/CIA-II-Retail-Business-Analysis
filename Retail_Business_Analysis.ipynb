   "source": [
    "\n",
    "df = raw_df.copy()\n",
    "\n",
    "# Convert date columns to datetime\n",
    "df[\"Order_Date\"] = pd.to_datetime(df[\"Order_Date\"], errors=\"coerce\")\n",
    "df[\"Ship_Date\"] = pd.to_datetime(df[\"Ship_Date\"], errors=\"coerce\")\n",
    "\n",
    "# Remove exact duplicate rows\n",
    "before_duplicates = len(df)\n",
    "df = df.drop_duplicates().copy()\n",
    "removed_duplicates = before_duplicates - len(df)\n",
    "\n",
    "# Fill categorical missing values with the mode\n",
    "segment_mode = df[\"Segment\"].mode()[0]\n",
    "df[\"Segment\"] = df[\"Segment\"].fillna(segment_mode)\n",
    "\n",
    "# Fill numerical missing values with robust central estimates\n",
    "df[\"Discount\"] = df[\"Discount\"].fillna(df[\"Discount\"].median())\n",
    "df[\"Profit\"] = df[\"Profit\"].fillna(df[\"Profit\"].median())\n",
    "\n",
    "# Feature engineering\n",
    "df[\"Order_Month\"] = df[\"Order_Date\"].dt.to_period(\"M\").astype(str)\n",
    "df[\"Order_Year\"] = df[\"Order_Date\"].dt.year\n",
    "df[\"Ship_Days\"] = (df[\"Ship_Date\"] - df[\"Order_Date\"]).dt.total_seconds() / 86400\n",
    "df[\"Profit_Margin\"] = np.where(df[\"Sales\"] != 0, (df[\"Profit\"] / df[\"Sales\"]) * 100, 0)\n",
    "\n",
    "# Sort for time-series analysis\n",
    "df = df.sort_values(\"Order_Date\").reset_index(drop=True)\n",
    "\n",
    "# Save cleaned data for reuse\n",
    "df.to_csv(CLEAN_FILE, index=False)\n",
    "\n",
    "print(f\"Duplicate rows removed: {removed_duplicates}\")\n",
    "print(\"Remaining missing values:\", int(df.isna().sum().sum()))\n",
    "display(df.head())\n"
   ]
  },
